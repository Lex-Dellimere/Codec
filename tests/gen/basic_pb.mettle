    codec_rd_fail(r, CODEC_ERR_TRUNCATED);
    return false;
  }
  return r->err == CODEC_OK;
}

// Merges the message in `data` into m. Strings and bytes in m point into
// `data`, so keep it alive while m is in use. Returns CODEC_OK or an error.
export fn Person_PlacesEntry_decode(m: Person_PlacesEntry*, data: string) -> int32 {
  var r: CodecReader;
  codec_rd_init_string(&r, data);
  if (!Person_PlacesEntry_read(m, &r, CODEC_PB_DEPTH, 0)) {
    if (r.err == CODEC_OK) { return CODEC_ERR_INVALID; }
    return r.err;
  }
  if (!Person_PlacesEntry_check(m)) { return CODEC_ERR_MISSING; }
  return CODEC_OK;
}

// True when every proto2 required field, here and in nested messages, is set.
export fn Person_PlacesEntry_check(m: Person_PlacesEntry*) -> bool {
  return true;
}

// Zeroes m and sets proto2 default values (has_ flags stay false).
export fn Person_PlacesEntry_init(m: Person_PlacesEntry*) {
  mem_zero((cstring)m, sizeof(Person_PlacesEntry));
}

// Frees the memory decoding allocated in m (nested messages and lists).
// Strings point into the decoded input and are not freed.
export fn Person_PlacesEntry_free(m: Person_PlacesEntry*) {
  if (m->value != 0) {
    Address_free(m->value);
    free(m->value);
    m->value = (Address*)0;
  }
  codec_list_free(&m->_unknown);
}

// rpc demo.v1.Directory.Lookup: Person -> Address (unary)
export const Directory_Lookup_PATH: string = "/demo.v1.Directory/Lookup";

// Client side: a request as one gRPC message (5-byte prefix and body) in w.
export fn Directory_Lookup_frame_request(req: Person*, w: CodecRev*) -> string {
  codec_rev_clear(w);
  Person_encode(req, w);
  codec_grpc_frame(w, 0);
  return codec_rev_view(w);
}

export fn Directory_Lookup_read_response(msg: H2GrpcMessage*, out: Address*) -> int32 {
  if (msg->compressed) { return CODEC_ERR_INVALID; }
  return Address_decode(out, codec_grpc_payload(msg));
}

// Server side.
export fn Directory_Lookup_read_request(msg: H2GrpcMessage*, req: Person*) -> int32 {
  if (msg->compressed) { return CODEC_ERR_INVALID; }
  return Person_decode(req, codec_grpc_payload(msg));
}

export fn Directory_Lookup_frame_response(resp: Address*, w: CodecRev*) -> string {
  codec_rev_clear(w);
  Address_encode(resp, w);
  codec_grpc_frame(w, 0);
  return codec_rev_view(w);
}

