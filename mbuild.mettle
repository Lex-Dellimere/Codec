// mbuild.mettle: the project file for Codec. `mbuild help` lists its commands.
//
// Layout: src/codec.mettle is the facade; each format sits in src/<format>/.
// Tests: tests/<name>_test.mettle, run with `mbuild test` and `mbuild test -r`.
import "mbuild/api";

fn project() {
  mb_package("codec", "0.1.0");
  mb_meta("description", "serialization in pure Mettle: Protocol Buffers with a .proto compiler and gRPC framing, MessagePack, a JSON writer and CBOR");
  mb_meta("license", "Apache-2.0");
  mb_meta("repository", "https://github.com/Lex-Dellimere/Codec");
  mb_import_root("src");
  mb_publish_include("src/, tools/protoc/, examples/, docs/, README.md, LICENSE, NOTICE");
  mb_bin("codec_protoc", "tools/protoc/main.mettle");
  mb_bin("floatdump", "tools/floatdump/main.mettle");
  mb_bin("codec_bench", "bench/main.mettle");
  mb_bin("example_protobuf", "examples/protobuf/main.mettle");
  mb_bin("example_msgpack", "examples/msgpack/main.mettle");
  mb_bin("example_json", "examples/json/main.mettle");
  mb_bin("example_cbor", "examples/cbor/main.mettle");
}

fn deps() {
}

// gen: rebuilds the protobuf code the tests and examples use.
fn cmd_gen(a: MbArgs*) -> int32 {
  if (mb_mbuild("build codec_protoc") != 0) { return 1; }
  var exe: string = mb_out("codec_protoc", mb_os(), "debug");
  if (mb_sh(exe + " -I tests/proto --out tests/gen basic.proto") != 0) { return 1; }
  return mb_sh(exe + " -I examples/protobuf --out examples/protobuf greeter.proto");
}

// conformance: runs Google's protobuf conformance suite against Codec.
// Needs a protobuf source tree with conformance_test_runner built in it
// (docs/conformance.md shows how). PROTOBUF_DIR points at it; the default
// is ~/.cache/codec-conformance (with src/ and build/ inside). -r tests a
// release build of the testee.
fn cmd_conformance(a: MbArgs*) -> int32 {
  if (mb_mbuild("build codec_protoc") != 0) { return 1; }
  var exe: string = mb_out("codec_protoc", mb_os(), "debug");
  var mode: string = "";
  if (mb_flag(a, "-r")) { mode = " --release"; }
  var script: string = "set -e; P=${{PROTOBUF_DIR:-$HOME/.cache/codec-conformance}; G=.mbuild/conformance; "
    + "rm -rf $G; mkdir -p $G; "
    + exe + " -I $P/src/conformance --out $G/c --prefix C conformance.proto; "
    + exe + " -I $P/src/src --out $G/p3 --prefix P3 google/protobuf/test_messages_proto3.proto; "
    + exe + " -I $P/src/src --out $G/p2 --prefix P2 google/protobuf/test_messages_proto2.proto; "
    + "\"${{METTLE:-mettle}\" --build" + mode + " tests/conformance/testee.mettle -o $G/testee; "
    + "$P/build/conformance_test_runner --enforce_recommended --maximum_edition PROTO3 $G/testee 2>&1 | grep -E 'CONFORMANCE SUITE|ERROR'";
  return mb_sh(script);
}

// fuzz: a long fuzzing run in release (`mbuild fuzz 1000000` for more rounds).
fn cmd_fuzz(a: MbArgs*) -> int32 {
  var n: string = "200000";
  if (mb_nargs(a) > 0) { n = mb_arg(a, 0); }
  return mb_sh("CODEC_FUZZ_ITERS=" + n + " \"$MBUILD_EXE\" test fuzz -r --force");
}

// package: lays out dist/codec for the Mettle package registry
// (website/registry.py add dist/codec, in the Mettle repository). The
// registry wants codec.mettle at the package root, so src/ becomes the root.
fn cmd_package(a: MbArgs*) -> int32 {
  var v: string = mb_version();
  var script: string = "set -e; rm -rf dist/codec; mkdir -p dist/codec/tools; "
    + "cp -r src/. dist/codec/; cp -r docs dist/codec/docs; "
    + "cp LICENSE NOTICE README.md dist/codec/; "
    + "cp tools/protoc/main.mettle dist/codec/tools/protoc.mettle; "
    + "printf 'name = codec\\nversion = " + v + "\\n"
    + "description = Serialization: Protocol Buffers with a .proto compiler and gRPC framing, MessagePack, a JSON writer and CBOR\\n"
    + "license = Apache-2.0\\nsource = https://github.com/Lex-Dellimere/Codec\\ncompiler = 0.18.0\\n' > dist/codec/mettle.package; "
    + "echo dist/codec";
  return mb_sh(script);
}
